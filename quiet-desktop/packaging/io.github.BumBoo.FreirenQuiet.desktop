[Desktop Entry]
Type=Application
Name=Freiren Quiet
Name[ko]=Freiren Quiet · 소음 관리
Comment=Power and thermal controls for the MSI GL62 6QE
Comment[ko]=노트북 온도와 성능을 조절해 더 조용하게
Exec=freiren-quiet gui
Icon=weather-clear-night
Terminal=false
Categories=Settings;HardwareSettings;
Keywords=fan;quiet;power;temperature;팬;소음;온도;
StartupNotify=true
StartupWMClass=freiren-quiet
Actions=Auto;Quiet;Restore;

[Desktop Action Auto]
Name=Automatic mode
Name[ko]=자동 모드
Exec=freiren-quiet mode auto

[Desktop Action Quiet]
Name=Quiet mode
Name[ko]=조용함 모드
Exec=freiren-quiet mode quiet

[Desktop Action Restore]
Name=Restore original settings
Name[ko]=관리 해제
Exec=freiren-quiet restore
