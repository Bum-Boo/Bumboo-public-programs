[Unit]
Description=Freiren Quiet - MSI GL62 6QE thermal and power controller
Requires=power-profiles-daemon.service
After=power-profiles-daemon.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/python -I /usr/lib/freiren-quiet/launcher.py daemon
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
RuntimeDirectory=freiren-quiet
RuntimeDirectoryMode=0755
StateDirectory=freiren-quiet
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=CAP_CHOWN
ReadOnlyPaths=/sys
ReadWritePaths=/sys/devices/system/cpu/intel_pstate
ReadWritePaths=/sys/devices/system/cpu/cpufreq
ReadWritePaths=-/sys/devices/virtual/powercap/intel-rapl/intel-rapl:0
MemoryMax=120M
CPUQuota=10%

[Install]
WantedBy=graphical.target
