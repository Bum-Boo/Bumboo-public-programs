{
  "manifestVersion": 5,
  "id": "com.typecast.shorts-sync.premiere",
  "name": "Typecast Shorts Sync",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "requiredPermissions": {
    "localFileSystem": "fullAccess"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "typecastShortsSync",
      "label": {
        "default": "Typecast Shorts Sync"
      },
      "minimumSize": {
        "width": 320,
        "height": 420
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 540
      }
    }
  ]
}
